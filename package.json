{
  "name": "agent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An authenticated Railway relay for agent messages, remote file context, and streamed attachments.",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "bridge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "start": "node dist/server/main.js",
    "dev": "tsx src/server/main.ts",
    "bridge": "tsx src/cli.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "commander": "^14.0.0",
    "fastify": "^5.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "railway": "^3.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
